# === Core ===
KATANA_MASTER_SECRET=replace_with_at_least_32_random_chars_here_abcdefgh
KATANA_API_TOKEN=generate_long_random_token_for_core_here

# === n8n (optional) ===
N8N_WEBHOOK_URL=http://n8n:5678/webhook/katana
N8N_WEBHOOK_TOKEN=generate_n8n_bearer_token

# === SSH Bridge ===
SSH_HOST=your.server.example.com
SSH_PORT=22
SSH_USER=deploy
SSH_KEY_PATH=/home/appuser/.ssh/id_ed25519
SSH_KNOWN_HOSTS=/home/appuser/.ssh/known_hosts
SSH_KEY_HOST_PATH=./keys

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ADMIN_USER_IDS=123456789
